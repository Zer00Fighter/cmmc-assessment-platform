@rem Copy this file to Omni.local.cmd. Never commit Omni.local.cmd.
@rem Use a dedicated Google Workspace mailbox and a 16-character App Password.
set "OMNI_EMAIL_ENABLED=1"
set "OMNI_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend"
set "OMNI_EMAIL_HOST=smtp.gmail.com"
set "OMNI_EMAIL_PORT=587"
set "OMNI_EMAIL_USE_TLS=1"
set "OMNI_EMAIL_USER=notifications@example.com"
set "OMNI_EMAIL_PASSWORD=PASTE_APP_PASSWORD_LOCALLY"
set "OMNI_DEFAULT_FROM_EMAIL=Omni by R!SC ^<notifications@example.com^>"
set "OMNI_BASE_URL=http://127.0.0.1:8000"
@rem Optional lifecycle locations and local-pilot backup retention.
set "OMNI_BACKUP_DIR=D:\RISC\Omni\local_backups"
set "OMNI_RESTORE_STAGING_DIR=D:\RISC\Omni\local_restore_staging"
set "OMNI_BACKUP_RETENTION_DAYS=30"
@rem Production-only security values. Keep local development defaults unless deploying behind HTTPS.
@rem set "OMNI_DEBUG=0"
@rem set "OMNI_SECRET_KEY=GENERATE_A_PRIVATE_RANDOM_VALUE_OF_AT_LEAST_50_CHARACTERS"
@rem set "OMNI_SECRET_KEY_FALLBACKS=PRIOR_KEY_DURING_A_CONTROLLED_ROTATION_ONLY"
@rem set "OMNI_ALLOWED_HOSTS=omni.itrisc.com"
@rem set "OMNI_CSRF_TRUSTED_ORIGINS=https://omni.itrisc.com"
@rem set "OMNI_BASE_URL=https://omni.itrisc.com"
@rem set "OMNI_TRUST_PROXY_HEADERS=1"
set "OMNI_SESSION_TIMEOUT_MINUTES=60"
